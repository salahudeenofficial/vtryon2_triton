# Dockerfile for Triton Inference Server with VTryon Models
# This image contains Triton server + all model code + ComfyUI
# Models are downloaded at runtime (not included in image to keep size small)

FROM nvcr.io/nvidia/tritonserver:25.10-py3

# Set working directory
WORKDIR /workspace

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    wget \
    curl \
    python3-pip \
    python3-venv \
    build-essential \
    libssl-dev \
    libffi-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements files first (for better Docker layer caching)
COPY latent_encoder/requirements.txt /tmp/latent_encoder_requirements.txt
COPY text_encoder/requirements.txt /tmp/text_encoder_requirements.txt
COPY sampling/requirements.txt /tmp/sampling_requirements.txt
COPY decoding/requirements.txt /tmp/decoding_requirements.txt

# Create and activate virtual environment
# Note: We use a virtual environment to avoid pip warnings and keep packages isolated
RUN python3 -m venv /opt/venv && \
    /opt/venv/bin/pip install --upgrade pip setuptools wheel

# Install Python dependencies in virtual environment
# Core ML packages (install first as they're large)
# Install PyTorch with CUDA 13.0 support (same as setup.sh files)
# Note: --extra-index-url must come before package names
RUN /opt/venv/bin/pip install --no-cache-dir \
    --extra-index-url https://download.pytorch.org/whl/cu130 \
    torch>=2.0.0 \
    torchvision>=0.15.0 \
    torchaudio && \
    /opt/venv/bin/pip install --no-cache-dir \
    torchsde \
    numpy>=1.25.0 \
    Pillow>=9.0.0

# Install ComfyUI dependencies (essential for ensemble pipeline)
RUN /opt/venv/bin/pip install --no-cache-dir \
    einops \
    transformers>=4.37.2 \
    tokenizers>=0.13.3 \
    sentencepiece \
    safetensors>=0.4.2 \
    aiohttp>=3.11.8 \
    yarl>=1.18.0 \
    pyyaml \
    scipy \
    tqdm \
    psutil \
    alembic \
    SQLAlchemy \
    av>=14.2.0 \
    kornia>=0.7.1 \
    spandrel \
    pydantic~=2.0 \
    pydantic-settings~=2.0

# Install microservice-specific dependencies
RUN /opt/venv/bin/pip install --no-cache-dir \
    python-dotenv>=1.0.0

# Clean up pip cache
RUN rm -rf /tmp/*_requirements.txt /root/.cache/pip

# Copy model repository structure (code only, no large model files)
# This includes:
# - All config.pbtxt files
# - All model.py files
# - All service code
# - ComfyUI modules
# - Ensemble configuration
COPY triton_model_repository/ /models/

# Copy model download script and entrypoint
COPY download_triton_models.sh /workspace/download_triton_models.sh
COPY entrypoint.sh /workspace/entrypoint.sh
RUN chmod +x /workspace/download_triton_models.sh /workspace/entrypoint.sh

# Validate ComfyUI structure
RUN if [ ! -d "/models/shared_comfyui/comfy" ]; then \
    echo "ERROR: ComfyUI not found in image - check COPY command"; \
    exit 1; \
    fi && \
    echo "✓ ComfyUI structure validated"

# Validate ensemble configuration exists
RUN if [ ! -f "/models/vtryon_pipeline/config.pbtxt" ]; then \
    echo "ERROR: Ensemble config not found - check COPY command"; \
    exit 1; \
    fi && \
    echo "✓ Ensemble configuration validated"

# Validate all model directories exist
RUN for model in latent_encoder text_encoder sampling decoding; do \
    if [ ! -d "/models/$model" ]; then \
        echo "ERROR: Model directory not found: $model"; \
        exit 1; \
    fi && \
    if [ ! -f "/models/$model/config.pbtxt" ]; then \
        echo "ERROR: Config not found for: $model"; \
        exit 1; \
    fi && \
    if [ ! -d "/models/$model/1" ]; then \
        echo "ERROR: Model version directory not found: $model/1"; \
        exit 1; \
    fi; \
    done && \
    echo "✓ All model directories validated"

# Create directories for runtime model downloads
RUN mkdir -p /models/shared_models/{vae,clip,diffusion_models,loras} && \
    chmod -R 755 /models && \
    echo "✓ Model directories created with proper permissions"

# Set environment variables for ensemble testing
# Add virtual environment to PATH so Python uses packages from venv
ENV PATH="/opt/venv/bin:${PATH}"
ENV PYTHONUNBUFFERED=1
ENV TRITON_MODEL_REPOSITORY=/models
ENV COMFYUI_PATH=/models/shared_comfyui
ENV PYTHONPATH=/models/shared_comfyui:${PYTHONPATH}
ENV MODEL_DIR=/models/shared_models

# Expose Triton ports
# 8000: HTTP
# 8001: gRPC
# 8002: Metrics
EXPOSE 8000 8001 8002

# Health check - verify Triton is ready and models are loaded
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD curl -f http://localhost:8000/v2/health/ready || exit 1

# Use entrypoint script to download models on startup, then start Triton
ENTRYPOINT ["/workspace/entrypoint.sh"]
