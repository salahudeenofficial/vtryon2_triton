name: "decoding"
backend: "python"
max_batch_size: 1

input {
  name: "latent"
  data_type: TYPE_FP32
  dims: [ 16, 1, 147, 110 ]
}

output {
  name: "image"
  data_type: TYPE_FP32
  dims: [ 1176, 880, 3 ]
}

# GPU configuration - all models run on GPU
# Models are dynamically offloaded to CPU between ensemble steps via model.py
instance_group [
  {
    count: 1
    kind: KIND_GPU
  }
]
